{
    "name": "template-tauri",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "bun@1.3.5",
    "scripts": {
      "up:external": "bunx npm-check-updates --dep prod,dev,optional,overrides --interactive --format group",
        "dev": "node log.js dev & tauri dev",
        "dev-nolog": "tauri dev",
        "vite-dev": "vite",
        "build": "node log.js build & tauri build",
        "build-nolog": "tauri build",
        "vite-build": "tsc && vite build",
        "test": "bun test",
        "preview": "vite preview",
        "tauri": "tauri",
        "check": "bun tsgo && bun lint && bun knip && bun knip --production --no-exit-code",
        "check:fix": "bun tsgo && bun lint:fix && bun knip && bun knip --production --no-exit-code",
        "lint": "biome check .",
        "lint:fix": "biome check --fix --unsafe .",
        "knip": "knip --no-config-hints",
        "tsgo": "tsgo --noEmit"
    },
    "dependencies": {
        "@strudel/web": "^1.2.6",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-opener": "^2",
        "canvaskit-wasm": "^0.40.0",
        "phaser": "^4.0.0-rc.6",
        "pixi.js": "^8.15.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2",
        "typescript": "~5.6.2",
        "vite": "^6.0.3",
        "@biomejs/biome": "2.3.10",
        "@typescript/native-preview": "7.0.0-dev.20251218.3",
        "knip": "5.71.0",
        "npm-check-updates": "^19.2.0"
    }
}
