{
    "name": "template-tauri",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "bun@1.3.5",
    "scripts": {
      "up:external": "bunx npm-check-updates --dep prod,dev,optional,overrides --interactive --format group",
      "dev": "tauri dev",
      "dev-nolog": "tauri dev",
      "vite-dev": "vite",
      "build": "tauri build",
      "build-nolog": "tauri build",
      "vite-build": "tsc && vite build",
      "test": "bun test",
      "preview": "vite preview",
      "tauri": "tauri",
      "terminal": "bun terminal/index.tsx",
      "check": "bun tsgo && bun lint && bun knip && bun knip --production --no-exit-code",
      "check:fix": "bun tsgo && bun lint:fix && bun knip && bun knip --production --no-exit-code",
      "lint": "biome check .",
      "lint:fix": "biome check --fix --unsafe .",
      "knip": "knip --no-config-hints",
      "tsgo": "tsgo --noEmit"
    },
    "dependencies": {
      "@types/bun": "^1.3.5",
        "@strudel/web": "^1.2.6",
        "@strudel/webaudio": "^1.2.6",
        "canvaskit-wasm": "^0.40.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2",
        "typescript": "~5.6.2",
        "vite": "^6.0.3",
        "@biomejs/biome": "2.3.10",
        "@typescript/native-preview": "7.0.0-dev.20251218.3",
        "knip": "5.71.0",
        "@types/react": "^18.3.0",
        "ink": "^5.0.0",
        "react": "^18.3.1",
        "npm-check-updates": "^19.2.0"
    }
}
