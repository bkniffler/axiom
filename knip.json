{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html!",
    "src/main.ts!",
    "test/**/*.test.ts"
  ],
  "bun": true,
  "vite": true,
  "includeEntryExports": false,
  "ignoreExportsUsedInFile": false,
  "ignore": [
    "**/dist/**",
    "**/build/**",
    "src-tauri/target/**",
    "src-tauri/gen/**",
    ".claude/**"
  ],
  "ignoreDependencies": [],
  "ignoreBinaries": []
}
