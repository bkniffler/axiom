{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html!",
    "src/main.ts!",
    "terminal/index.tsx!",
    "terminal/llm.ts!",
    "test/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "terminal/**/*.{ts,tsx}!",
    "vite.config.ts!",
    "test/**/*.{ts,tsx}"
  ],
  "bun": true,
  "vite": true,
  "includeEntryExports": false,
  "ignoreExportsUsedInFile": false,
  "ignore": [
    "**/dist/**",
    "**/build/**",
    "src-tauri/target/**",
    "src-tauri/gen/**",
    ".claude/**"
  ],
  "ignoreDependencies": [],
  "ignoreBinaries": []
}
