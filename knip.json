{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html!",
    "vite.config.ts!",
    "src/main.ts!",
    "test/*.test.ts"
  ],
  "project": [
    "tsconfig.json"
  ],
  "bun": true,
  "vite": true,
  "includeEntryExports": false,
  "ignoreExportsUsedInFile": false,
  "ignore": [
    "**/dist/**",
    "**/build/**",
    "src-tauri/**",
    ".claude/**",
    "**/*.stories.*",
    "src/scenes/**",
    "src/shaders/**",
    "src/styles/**",
    "src/svg/**"
  ],
  "ignoreDependencies": [
    "@types/bun",
    "bun-types",
    "@tauri-apps/api",
    "@tauri-apps/plugin-opener",
    "phaser",
    "pixi.js"
  ],
  "ignoreBinaries": []
}
